---
// The frame every page shares: language, viewport, title and the site nav.
import "../styles.css";

interface Props {
  title: string;
  /** Let the page use the whole window, for side-by-side working views. */
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/" aria-current={here === "/" || here.startsWith("/plans/") ? "page" : undefined}>Planner</a>
      <a href="/readme/" aria-current={here === "/readme/" ? "page" : undefined}>About</a>
    </nav>
    <main class:list={{ wide }}>
      <slot />
    </main>
  </body>
</html>
