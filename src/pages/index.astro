---
import Base from "../layouts/Base.astro";
import { listPlans, TIMETABLE } from "../lib/db";

const plans = listPlans();
// the scrape records "<url> (what was filtered)"; the link wants just the url
const sourceUrl = TIMETABLE.source.split(" ")[0];
const scraped = new Date(TIMETABLE.scrapedAt).toLocaleDateString("en-AU", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Australia/Sydney",
});
const edited = (iso: string) =>
  new Date(iso).toLocaleString("en-AU", {
    day: "numeric",
    month: "short",
    hour: "numeric",
    minute: "2-digit",
    timeZone: "Australia/Sydney",
  });
---

<Base title="Timetable planner">
  <h1>Timetable planner</h1>
  <p class="lede">
    Try out a Semester {TIMETABLE.semester.replace(/^S/, "")} {TIMETABLE.year} COMP timetable before enrolment
    opens. Pick your courses, choose a class for each activity, and see the clashes, week by
    week. Drafts are saved as you go.
  </p>
  <p class="source">
    Class times from the <a href={sourceUrl}>ANU public timetable</a>, copied on {scraped}.
    Check the official timetable before you enrol.
  </p>

  <form method="post" action="/api/plans" class="new-plan">
    <label for="name">New draft</label>
    <input id="name" name="name" maxlength="80" placeholder="e.g. Light Thursday" />
    <button>Start draft</button>
  </form>

  <section aria-labelledby="drafts">
    <h2 id="drafts">Your drafts</h2>
    {
      plans.length === 0 ? (
        <p class="empty">No drafts yet. Start one above.</p>
      ) : (
        <ul class="plans">
          {plans.map((plan) => (
            <li>
              <a href={`/plans/${plan.id}`}>{plan.name}</a>
              <span class="meta">
                {plan.courses} {plan.courses === 1 ? "course" : "courses"} · edited {edited(plan.updatedAt)}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
